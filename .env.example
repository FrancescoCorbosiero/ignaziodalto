# ── Fonte del catalogo: l'API di scs-b2b (docs/10-catalog-api.md di scs-b2b) ──
# Vuoti = si usa la fixture (fixtures/catalog.json): solo per sviluppo.
CATALOG_API_URL=https://b2b.shoesclothingstore.com/api/v1/catalogo
# Lo STESSO valore di CATALOG_API_TOKEN nel .env di scs-b2b. Riservato: mai committare.
CATALOG_API_TOKEN=
# Ogni quanti secondi si chiede a scs-b2b se il listino è cambiato (min 60).
# Se non è cambiato scs-b2b risponde 304: la chiamata costa pochi byte.
CATALOG_REFRESH_SECONDS=300

# ── Prezzi ───────────────────────────────────────────────────────────
# prezzo mostrato = (netto di listino scs-b2b + PRICE_MARKUP_EUR) × (1 + VAT_RATE/100)
# Il margine sta sull'IMPONIBILE (decisione del titolare); l'IVA si applica
# per ultima, arrotondata al centesimo. Es.: 75,00 + 3,50 = 78,50 → 95,77 €.
PRICE_MARKUP_EUR=3.50
# Aliquota IVA in percentuale. 0 = prezzi netti (IVA esclusa).
VAT_RATE=22
# Nota accanto ai prezzi e nel piè di pagina. Vuota = "Prezzi IVA inclusa"
# (o "Prezzi IVA esclusa" con VAT_RATE=0).
PRICE_NOTE=

# ── Sito ─────────────────────────────────────────────────────────────
SITE_DOMAIN=ignaziodalto.alpacode.it
# Indirizzo pubblico: finisce nei link dei messaggi WhatsApp/e-mail.
SITE_URL=https://ignaziodalto.alpacode.it
SITE_NAME="Ignazio Dalto"
SITE_TAGLINE="Sneakers originali, disponibilità aggiornata"

# ── Contatti: dove arrivano le richieste dei clienti ────────────────
# WhatsApp con prefisso internazionale (es. +39 333 1234567). Se vuoto, le
# richieste partono via e-mail; se vuoti entrambi, niente bottone "Richiedi".
CONTACT_WHATSAPP=
CONTACT_EMAIL=
CONTACT_INSTAGRAM=

# ── Badge ────────────────────────────────────────────────────────────
# "Novità": modelli comparsi negli ultimi N giorni.
NEW_DAYS=14
# Taglia con N paia o meno: "Ultimo" / "Ultimi N".
LOW_STOCK_MAX=2
