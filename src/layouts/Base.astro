---
import '@fontsource/big-shoulders-display/800';
import '@fontsource/big-shoulders-display/900';
import '@fontsource-variable/hanken-grotesk/wght';
import '../styles/global.css';
import FavCount from '../components/FavCount.tsx';
import { env, priceNoteFor, taglineFor } from '../server/env.ts';
import { contactHref } from '../lib/contact.ts';
import { LOCALES, t as dict } from '../i18n.ts';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
}

const { title, description, image } = Astro.props;
const locale = Astro.locals.locale;
const t = dict(locale);
const tagline = taglineFor(locale);
const fullTitle = title ? `${title} · ${env.siteName}` : `${env.siteName} — Sneakers`;
const desc = description ?? tagline;
const contact = contactHref(env, t.greeting(env.siteName), locale);
const ogImage = image ? new URL(`${image}?w=1080`, Astro.url).href : null;
const [first, ...rest] = env.siteName.split(' ');
const here = Astro.url.pathname + Astro.url.search;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noimageindex" />
    <meta name="theme-color" content="#f2f0ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e0d" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // before the first paint: JS on, and the theme the visitor chose (else the system's)
      document.documentElement.classList.add('has-js');
      try {
        var th = localStorage.getItem('id:theme');
        if (th === 'dark' || th === 'light') document.documentElement.dataset.theme = th;
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label={`${env.siteName}, ${t.catalog}`}>
          {first}{rest.length > 0 && <i>{rest.join(' ')}</i>}
        </a>
        <div class="header-actions">
          <nav class="lang" aria-label={t.language}>
            {
              LOCALES.map((l) => (
                <a href={`/lingua/${l}?to=${encodeURIComponent(here)}`} aria-current={l === locale ? 'true' : undefined} lang={l} hreflang={l}>
                  {l.toUpperCase()}
                </a>
              ))
            }
          </nav>
          <button type="button" class="btn btn-ghost icon-btn theme-toggle" aria-label={t.themeToggle} title={t.themeToggle}>
            <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" />
            </svg>
            <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
          <FavCount client:idle locale={locale} />
          {
            contact && (
              <a class="btn btn-solid" href={contact} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 20l1.4-4.2A8 8 0 1 1 8.6 19L4 20Z" />
                </svg>
                <span class="label-wide">{t.writeUs}</span>
              </a>
            )
          }
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <a class="wordmark" href="/">{first}{rest.length > 0 && <i>{rest.join(' ')}</i>}</a>
          <p class="footer-tag">{tagline}</p>
        </div>
        <ul class="footer-links">
          <li><a href="/#catalogo">{t.catalog}</a></li>
          <li><a href="/preferiti">{t.favorites}</a></li>
          {env.whatsapp && <li><a href={`https://wa.me/${env.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a></li>}
          {env.email && <li><a href={`mailto:${env.email}`}>{env.email}</a></li>}
          {env.instagram && <li><a href={`https://instagram.com/${env.instagram}`} target="_blank" rel="noopener">@{env.instagram}</a></li>}
        </ul>
        <p class="footer-note">{priceNoteFor(locale)}. {t.footerNote}</p>
      </div>
    </footer>
    <script>
      // light/dark: flips the current look and remembers it
      const root = document.documentElement;
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('id:theme', next);
        } catch {
          /* this page only */
        }
      });
    </script>
  </body>
</html>
