---
import '@fontsource/big-shoulders-display/800';
import '@fontsource/big-shoulders-display/900';
import '@fontsource-variable/hanken-grotesk/wght';
import '../styles/global.css';
import FavCount from '../components/FavCount.tsx';
import { env } from '../server/env.ts';
import { contactHref } from '../lib/contact.ts';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
}

const { title, description, image } = Astro.props;
const fullTitle = title ? `${title} · ${env.siteName}` : `${env.siteName} — Sneakers`;
const desc = description ?? env.tagline;
const contact = contactHref(env, `Ciao! Ti scrivo dal catalogo ${env.siteName}.`);
const ogImage = image ? new URL(`${image}?w=1080`, Astro.url).href : null;
const [first, ...rest] = env.siteName.split(' ');
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noimageindex" />
    <meta name="theme-color" content="#f2f0ea" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('has-js');</script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label={`${env.siteName}, catalogo`}>
          {first}{rest.length > 0 && <i>{rest.join(' ')}</i>}
        </a>
        <div class="header-actions">
          <FavCount client:idle />
          {
            contact && (
              <a class="btn btn-solid" href={contact} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 20l1.4-4.2A8 8 0 1 1 8.6 19L4 20Z" />
                </svg>
                <span class="label-wide">Scrivici</span>
              </a>
            )
          }
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p><strong>{env.siteName}</strong> · {env.tagline}</p>
        <p>
          {env.priceNote}. Disponibilità e prezzi possono cambiare: la conferma arriva quando ci scrivi.
        </p>
        <p>
          {env.whatsapp && <a href={`https://wa.me/${env.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>}
          {env.whatsapp && (env.email || env.instagram) && ' · '}
          {env.email && <a href={`mailto:${env.email}`}>{env.email}</a>}
          {env.email && env.instagram && ' · '}
          {env.instagram && <a href={`https://instagram.com/${env.instagram}`} target="_blank" rel="noopener">@{env.instagram}</a>}
        </p>
      </div>
    </footer>
  </body>
</html>
