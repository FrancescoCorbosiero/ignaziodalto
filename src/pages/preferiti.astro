---
import Base from '../layouts/Base.astro';
import Favorites from '../components/Favorites.tsx';
import { env } from '../server/env.ts';
import { t as dict } from '../i18n.ts';

const locale = Astro.locals.locale;
const t = dict(locale);
const contact = { siteName: env.siteName, whatsapp: env.whatsapp, email: env.email };
---

<Base title={t.favorites}>
  <div class="wrap" style="padding-block:32px 64px;max-width:960px">
    <h1 class="section-title">{t.favTitle}</h1>
    <Favorites client:load contact={contact} origin={env.siteUrl} locale={locale} />
  </div>
</Base>
