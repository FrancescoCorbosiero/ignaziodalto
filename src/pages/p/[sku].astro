---
import Base from '../../layouts/Base.astro';
import ProductBuy from '../../components/ProductBuy.tsx';
import Rail from '../../components/Rail.tsx';
import { Badges, Picture } from '../../components/ProductCard.tsx';
import { product, products, meta } from '../../server/catalog.ts';
import { env, priceNoteFor, vatTagFor } from '../../server/env.ts';
import { t as dict } from '../../i18n.ts';
import { euro, when } from '../../lib/format.ts';

const locale = Astro.locals.locale;
const t = dict(locale);
const priceNote = priceNoteFor(locale);

const raw = Astro.params.sku ?? '';
const decoded = (() => {
  try {
    return decodeURIComponent(raw);
  } catch {
    return raw;
  }
})();
const p = product(raw) ?? product(decoded);
if (!p) {
  Astro.response.status = 404;
}

const related = p
  ? products()
      .filter((x) => x.sku !== p.sku && x.qty > 0 && x.brand === p.brand)
      .sort((a, b) => Number(b.isNew) - Number(a.isNew) || b.qty - a.qty)
      .slice(0, 8)
  : [];
const fallback = p && related.length < 4
  ? products().filter((x) => x.sku !== p.sku && x.qty > 0 && x.brand !== p.brand).sort((a, b) => b.qty - a.qty).slice(0, 8 - related.length)
  : [];
const updated = when(meta().syncedAt, locale);
const contact = { siteName: env.siteName, whatsapp: env.whatsapp, email: env.email };
---

{
  p ? (
    <Base title={p.name} description={`${p.brand} · ${p.name} · ${t.from} ${euro(p.from, locale)} (${priceNote.toLowerCase()})`} image={p.image}>
      <div class="wrap">
        <nav class="crumbs" aria-label={t.path}>
          <a href="/#catalogo">{t.catalog}</a>
          <span aria-hidden="true">/</span>
          <a href={`/?brand=${encodeURIComponent(p.brand)}#catalogo`}>{p.brand}</a>
        </nav>
        <article class="pdp">
          <div class="pdp-media">
            <Picture p={p} eager large sizes="(max-width: 900px) 100vw, 55vw" />
            <Badges p={p} locale={locale} />
          </div>
          <div class="pdp-info">
            <p class="pdp-brand">
              <a href={`/?brand=${encodeURIComponent(p.brand)}#catalogo`}>{p.brand}</a>
            </p>
            <h1 class="pdp-title">{p.name}</h1>
            <p class="pdp-sku">{`${t.code} ${p.sku}`}</p>
            <ProductBuy client:load p={p} contact={contact} priceNote={priceNote} lowStock={env.lowStock} origin={env.siteUrl} locale={locale} />
            <ul class="facts">
              <li>
                <span>{t.category}</span>
                <span>{t.categories[p.category]}</span>
              </li>
              <li>
                <span>{t.sizesInStock}</span>
                <span>{t.ofTotal(p.sizes.filter((s) => s.qty > 0).length, p.sizes.length)}</span>
              </li>
              {
                updated && (
                  <li>
                    <span>{t.availability}</span>
                    <span class="live">{t.updatedShort(updated)}</span>
                  </li>
                )
              }
            </ul>
          </div>
        </article>
      </div>
      {
        related.length + fallback.length > 0 && (
          <section class="wrap rail">
            <h2 class="section-title">{related.length > 0 ? t.moreFrom(p.brand) : t.youMayLike}</h2>
            <Rail client:visible items={[...related, ...fallback]} locale={locale} vat={vatTagFor(locale)} scroll />
          </section>
        )
      }
    </Base>
  ) : (
    <Base title={t.modelNotFound}>
      <div class="wrap empty" style="min-height:50vh;align-content:center">
        <h2>{t.goneTitle}</h2>
        <p>{t.goneText}</p>
        <a class="btn btn-solid" href="/#catalogo">{t.goToCatalog}</a>
      </div>
    </Base>
  )
}
