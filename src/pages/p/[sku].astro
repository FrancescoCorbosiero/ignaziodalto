---
import Base from '../../layouts/Base.astro';
import ProductBuy from '../../components/ProductBuy.tsx';
import Rail from '../../components/Rail.tsx';
import { Badges, Picture } from '../../components/ProductCard.tsx';
import { product, products, meta } from '../../server/catalog.ts';
import { env } from '../../server/env.ts';
import { euro, when } from '../../lib/format.ts';
import { CATEGORY_LABEL } from '../../lib/types.ts';

const raw = Astro.params.sku ?? '';
const decoded = (() => {
  try {
    return decodeURIComponent(raw);
  } catch {
    return raw;
  }
})();
const p = product(raw) ?? product(decoded);
if (!p) {
  Astro.response.status = 404;
}

const related = p
  ? products()
      .filter((x) => x.sku !== p.sku && x.qty > 0 && x.brand === p.brand)
      .sort((a, b) => Number(b.isNew) - Number(a.isNew) || b.qty - a.qty)
      .slice(0, 8)
  : [];
const fallback = p && related.length < 4
  ? products().filter((x) => x.sku !== p.sku && x.qty > 0 && x.brand !== p.brand).sort((a, b) => b.qty - a.qty).slice(0, 8 - related.length)
  : [];
const updated = when(meta().syncedAt);
const contact = { siteName: env.siteName, whatsapp: env.whatsapp, email: env.email };
---

{
  p ? (
    <Base title={p.name} description={`${p.brand} · ${p.name} · da ${euro(p.from)} (${env.priceNote.toLowerCase()})`} image={p.image}>
      <div class="wrap">
        <nav class="crumbs" aria-label="Percorso">
          <a href="/">Catalogo</a>
          <span aria-hidden="true">/</span>
          <a href={`/?brand=${encodeURIComponent(p.brand)}`}>{p.brand}</a>
        </nav>
        <article class="pdp">
          <div class="pdp-media">
            <Picture p={p} eager large sizes="(max-width: 900px) 100vw, 55vw" />
            <Badges p={p} />
          </div>
          <div class="pdp-info">
            <p class="pdp-brand">
              <a href={`/?brand=${encodeURIComponent(p.brand)}`}>{p.brand}</a>
            </p>
            <h1 class="pdp-title">{p.name}</h1>
            <p class="pdp-sku">Codice {p.sku}</p>
            <ProductBuy client:load p={p} contact={contact} priceNote={env.priceNote} lowStock={env.lowStock} origin={env.siteUrl} />
            <ul class="facts">
              <li>
                <span>Categoria</span>
                <span>{CATEGORY_LABEL[p.category]}</span>
              </li>
              <li>
                <span>Taglie disponibili</span>
                <span>{p.sizes.filter((s) => s.qty > 0).length} su {p.sizes.length}</span>
              </li>
              {
                updated && (
                  <li>
                    <span>Disponibilità</span>
                    <span class="live">aggiornata {updated}</span>
                  </li>
                )
              }
            </ul>
          </div>
        </article>
      </div>
      {
        related.length + fallback.length > 0 && (
          <section class="wrap rail">
            <h2 class="section-title">{related.length > 0 ? `Altre ${p.brand}` : 'Potrebbero piacerti'}</h2>
            <Rail client:visible items={[...related, ...fallback]} />
          </section>
        )
      }
    </Base>
  ) : (
    <Base title="Modello non trovato">
      <div class="wrap empty" style="min-height:50vh;align-content:center">
        <h2>Non c’è più</h2>
        <p>Questo modello non è più a catalogo: il fornitore lo ha esaurito o ritirato. Dai un’occhiata a quelli disponibili.</p>
        <a class="btn btn-solid" href="/">Vai al catalogo</a>
      </div>
    </Base>
  )
}
